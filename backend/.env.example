# Mausam Next-Gen backend — copy to .env and adjust as needed.
# Every value is optional; the app boots with these defaults.

# LIVE = real govt endpoints only | HYBRID = live-then-fixtures (default) | SEED = offline demo
API_MODE=HYBRID
LIVE_TIMEOUT_MS=1200

ENVIRONMENT=dev
LOG_LEVEL=INFO

REDIS_URL=redis://localhost:6379/0
CACHE_FORECAST_TTL_S=1800
CACHE_NOWCAST_TTL_S=300

# --- Sovereign data federation (Phase 1) ---
# api.data.gov.in key — the public sample key works for development:
#   579b464db66ec23bdd000001cdd3946e44ce4aad7209ff7b23ac571b
# Register your own for the hackathon submission.
DATA_GOV_API_KEY=
DATA_GOV_IMD_RESOURCE=          # IMD current-weather resource id (team to register)
INCOIS_OSF_URL=                 # optional INCOIS OSF JSON endpoint
CAP_FEED_URL=                   # optional NDMA SACHET CAP XML feed (blank = bundled fixture)

# --- Phase 2+ keys ---
IMD_API_KEY=                    # api.imd.gov.in subscription key
BHASHINI_API_KEY=
FCM_CREDENTIALS_JSON=

# Circuit breaker (HybridCircuitBreaker, TASK-014)
ADAPTER_FAILURE_THRESHOLD=3
ADAPTER_RESET_TIME_S=60
